@startuml 20-4-implantacao
!include _tema.puml
!include <C4/C4_Deployment>

top to bottom direction

Deployment_Node(dispositivo, "Dispositivo do usuário", "Computador ou celular") {
  Container(navegador, "Navegador", "React 19", "Interface carregada de viaja-mais.online")
}

Deployment_Node(vercel, "Vercel", "Hospedagem gerenciada") {
  Deployment_Node(borda, "Rede de borda", "CDN") {
    Container(estaticos, "Arquivos estáticos", "JS, CSS, imagens de _next/static")
  }
  Deployment_Node(funcoes, "Funções sob demanda", "Node.js, sem estado") {
    Container(app, "Aplicação Next.js", "Next.js 16", "proxy.ts, Server Components e route handlers")
  }
}

Deployment_Node(supabase, "Projeto Supabase de produção", "Serviço gerenciado") {
  ContainerDb(pg, "PostgreSQL", "PostgreSQL 17 + RLS", "Schema aplicado manualmente a partir de supabase/migrations")
  Container(auth, "Auth e Storage", "GoTrue e Storage", "Sessão, e-mails e buckets privados")
}

Deployment_Node(github, "GitHub", "Repositório e esteira") {
  Container(repo, "Repositório", "Git", "Branch main é a versão publicada")
  Deployment_Node(runner, "GitHub Actions", "ubuntu-latest") {
    Deployment_Node(docker, "Docker", "Supabase CLI 2.104.0") {
      ContainerDb(local, "Supabase local efêmero", "Auth, PostgreSQL, Storage", "Migrations do zero, testes de RLS e E2E")
    }
  }
}

Rel(navegador, estaticos, "Baixa", "HTTPS")
Rel(navegador, app, "Páginas e /api/**", "HTTPS")
Rel(app, pg, "Consultas com a sessão", "HTTPS")
Rel(app, auth, "Valida token, envia convite, grava fotos", "HTTPS")
Rel(repo, local, "PR e push na main disparam os workflows", "ci.yml, db.yml")
Rel(repo, app, "Merge na main publica", "integração Git da Vercel")

@enduml
