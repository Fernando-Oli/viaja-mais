@startuml 20-2-c4-conteineres
!include _tema.puml
!include <C4/C4_Container>

' Nomes genéricos para os serviços externos; a seção 21 diz qual provedor
' cumpre cada papel hoje.

top to bottom direction

Person(viajante, "Viajante", "Pessoa autenticada; o visitante e o convidado usam os mesmos contêineres.")

System_Boundary(viajamais, "Viaja Mais") {
  Container(navegador, "Interface no navegador", "React 19, Tailwind CSS 4, shadcn/ui", "Componentes de cliente: formulários, listas, mapa. Não escreve no banco.")
  Container(app, "Aplicação web", "Next.js 16 (App Router), Node.js", "proxy.ts, Server Components e 41 route handlers em app/api/**. Única porta de escrita.")
}

System_Boundary(servicos, "Serviço de dados e identidade (gerenciado)") {
  Container_Ext(auth, "Autenticação", "Sessão por token", "Cadastro, sessão, recuperação de senha e convite por e-mail.")
  ContainerDb_Ext(pg, "Banco de dados", "PostgreSQL + RLS", "18 tabelas, políticas de RLS, funções e gatilhos, versionados em 22 migrations.")
  ContainerDb_Ext(arquivos, "Armazenamento de arquivos", "Buckets privados", "Fotos de perfil e capas de post. Sem política de escrita para usuário.")
}

System_Ext(mapas, "Serviço de mapas", "Busca de lugares e mapa")
System_Ext(ia, "Serviço de IA", "Geração do roteiro")

Rel(viajante, navegador, "Usa", "HTTPS")
Rel(navegador, app, "Páginas e fetch('/api/...')", "HTTPS + cookie de sessão")
Rel(navegador, auth, "Login, cadastro e recuperação de senha", "HTTPS, chave pública")
Rel(navegador, mapas, "Busca de lugares", "HTTPS, chave pública")
Rel(app, auth, "Valida o token e envia convite", "HTTPS")
Rel(app, pg, "Lê e grava com a sessão do usuário: a RLS vale", "HTTPS")
Rel(app, arquivos, "Grava e assina fotos com a chave de serviço", "HTTPS")
Rel(app, ia, "Pede o roteiro; a chave fica no servidor", "HTTPS")
Rel(auth, pg, "Identidade do usuário usada nas políticas")

@enduml
