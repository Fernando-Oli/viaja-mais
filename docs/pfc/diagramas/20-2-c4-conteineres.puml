@startuml 20-2-c4-conteineres
!include _tema.puml
!include <C4/C4_Container>

top to bottom direction

Person(viajante, "Viajante", "Pessoa autenticada; o visitante e o convidado usam os mesmos contêineres.")

System_Boundary(viajamais, "Viaja Mais") {
  Container(navegador, "Interface no navegador", "React 19, Tailwind CSS 4, shadcn/ui", "Componentes de cliente: formulários, listas, mapa. Não escreve no banco.")
  Container(app, "Aplicação Next.js", "Next.js 16 (App Router), Node.js, Vercel", "proxy.ts, Server Components e 39 route handlers em app/api/**. Única porta de escrita.")
}

System_Boundary(supa, "Projeto Supabase (serviço gerenciado)") {
  Container_Ext(auth, "Supabase Auth", "GoTrue", "Cadastro, sessão por token, recuperação de senha e convite por e-mail.")
  ContainerDb_Ext(pg, "PostgreSQL", "PostgreSQL 17 + RLS", "18 tabelas, políticas de RLS, funções e gatilhos, versionados em 22 migrations.")
  ContainerDb_Ext(storage, "Supabase Storage", "Buckets privados", "avatars e capas-posts. Sem política de escrita para usuário.")
}

System_Ext(maps, "Google Maps Platform", "Maps JavaScript API e Places")

Rel(viajante, navegador, "Usa", "HTTPS")
Rel(navegador, app, "Páginas e fetch('/api/...')", "HTTPS + cookie de sessão")
Rel(navegador, auth, "Login, cadastro e recuperação de senha", "HTTPS, chave anon")
Rel(navegador, maps, "Busca de lugares", "HTTPS, chave pública")
Rel(app, auth, "Valida o token (getUser) e envia convite", "HTTPS")
Rel(app, pg, "Lê e grava com a sessão do usuário: a RLS vale", "HTTPS, PostgREST")
Rel(app, storage, "Grava e assina fotos com a chave de serviço", "HTTPS")
Rel(auth, pg, "Usuários no schema auth; auth.uid() nas políticas")

@enduml
