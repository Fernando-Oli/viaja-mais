  usecase "UC17 Gerenciar lugares no mapa" as UC17
  usecase "UC18 Avaliar lugar" as UC18
  usecase "UC19 Registrar despesa com rateio" as UC19
  usecase "UC20 Editar ou excluir despesa" as UC20
  usecase "UC21 Acertar contas" as UC21
