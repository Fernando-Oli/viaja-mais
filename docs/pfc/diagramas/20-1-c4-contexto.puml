@startuml 20-1-c4-contexto
!include _tema.puml
!include <C4/C4_Context>

' Nomes genéricos de propósito: o provedor de cada serviço pode mudar sem que a
' arquitetura mude. A correspondência com os provedores atuais está na seção 21.

top to bottom direction

Person(visitante, "Visitante", "Pessoa sem sessão. Acessa só a página inicial e as telas de cadastro, login e recuperação de senha.")
Person(viajante, "Viajante", "Pessoa autenticada. Organiza viagens, itinerário, reservas, lugares e despesas, e usa a rede social.")
Person(convidado, "Convidado", "Pessoa convidada por e-mail pelo dono de uma viagem. Aceita ou recusa o convite.")

System(viajamais, "Viaja Mais", "Aplicação web de planejamento de viagens em grupo, com controle financeiro compartilhado e rede social.")

System_Ext(backend, "Serviço de dados e identidade", "Autenticação, banco PostgreSQL e armazenamento de arquivos. Envia os e-mails de convite e de recuperação de senha.")
System_Ext(mapas, "Serviço de mapas", "Busca de lugares e exibição no mapa.")
System_Ext(ia, "Serviço de IA", "Gera o roteiro dia a dia que o viajante revisa antes de criar a viagem.")

Rel(visitante, viajamais, "Cadastra-se e entra", "HTTPS")
Rel(viajante, viajamais, "Planeja viagens e registra despesas", "HTTPS")
Rel(convidado, viajamais, "Aceita ou recusa o convite", "HTTPS")

Rel(viajamais, backend, "Autentica, lê e grava dados e arquivos", "HTTPS")
Rel(viajamais, mapas, "Busca lugares (a partir do navegador)", "HTTPS")
Rel(viajamais, ia, "Pede o roteiro (a partir do servidor)", "HTTPS")
Rel(backend, convidado, "Envia o convite", "e-mail")

@enduml
