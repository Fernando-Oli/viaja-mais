# =============================================================================
# ViajaMais — referência das variáveis de ambiente.
#
# NA MAIOR PARTE DOS CASOS VOCÊ NÃO PRECISA PREENCHER ISTO À MÃO:
#
#     npm run setup
#
# sobe o Supabase local e escreve o .env.local com as credenciais que o próprio
# stack gerou. Este arquivo serve de referência e para deploy.
#
# Tudo que começa com NEXT_PUBLIC_ é embutido no JavaScript do navegador e fica
# visível para qualquer usuário. Segredo nenhum entra com esse prefixo.
# =============================================================================

# --- Banco próprio (migração sem Supabase, em andamento) ---------------------
# Sobe com `docker compose up -d --wait`; recria com `npm run db:reset`.
# Os valores abaixo são os padrões locais do docker-compose.yml e só precisam
# ser definidos para mudar a senha ou apontar para outro banco local.
#
# Superusuário: só scripts/db/* (migrations e seed). Nunca a aplicação.
# DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:55432/avori
# Conexão da API: sem privilégio próprio, assume o papel do usuário por transação.
# DB_APP_API_URL=postgresql://app_api:app_api_local@localhost:55432/avori
# Conexão do Better Auth: só as tabelas do schema auth.
# DB_APP_AUTH_URL=postgresql://app_auth:app_auth_local@localhost:55432/avori

# --- Fotos de perfil (S3) ------------------------------------------------------
# Local: o SeaweedFS do docker-compose.yml, com os padrões abaixo (não precisa
# definir). Produção: o S3 da AWS — sem S3_ENDPOINT, e sem as chaves se a
# máquina tiver papel IAM; S3_BUCKET_AVATARES é obrigatório (bucket privado).
# S3_ENDPOINT=http://localhost:58333
# S3_ENDPOINT_PUBLICO=          (só se a API acessar o S3 por um nome interno)
# S3_REGIAO=us-east-1
# S3_CHAVE_ACESSO=avori_local
# S3_CHAVE_SECRETA=avori_local_segredo
# S3_BUCKET_AVATARES=avatars
# Para a CSP do Next liberar as fotos locais (http). Em produção, deixe vazio.
# ARMAZENAMENTO_URL_PUBLICA=http://localhost:58333

# --- Supabase (sai ao fim da migração) ---------------------------------------
# Local: http://localhost:54321 (gerado por `npm run setup`)
# Deploy: Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de servidor: IGNORA TODA A RLS. Sem prefixo NEXT_PUBLIC_ de propósito.
# Só pode ser lida em route handler / server component (lib/supabase/admin.ts).
# Necessária para o convite por e-mail (auth.admin.inviteUserByEmail).
SUPABASE_SERVICE_ROLE_KEY=

# String de conexão direta — usada pelas migrations e pelos testes de RLS.
# Dashboard > Project Settings > Database > Connection string (URI).
DATABASE_URL=postgresql://postgres:[SENHA]@db.xxxx.supabase.co:5432/postgres

# --- URL da aplicação (obrigatório) ------------------------------------------
# Substitui NEXT_PUBLIC_SITE_URL e NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL, que
# hoje coexistem sem motivo. Sem barra no final.
# Local: http://localhost:3000   Produção: https://seu-dominio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google Maps (obrigatório para busca de lugares) -------------------------
# Exposta no navegador por design (a API JS exige). A proteção é restringir a
# chave por HTTP referrer + por API + cota no Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- IA de roteiros ----------------------------------------------------------
# fake   = gerador determinístico, sem rede. Padrão em dev e no CI.
# gemini = free tier do Google.        anthropic = Claude, se conseguirem chave.
AI_PROVIDER=fake
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Notion (só no CI; não precisa em dev) -----------------------------------
# Integração interna em notion.so/my-integrations, compartilhada com a página-mãe.
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_DB_ATIVIDADES=
NOTION_DB_REQUISITOS=
NOTION_DB_CRONOGRAMA=
NOTION_DB_DECISOES=

# --- Testes E2E (dois usuários, para provar isolamento por RLS) --------------
# Criados por supabase/seed.sql no ambiente local, com senha Viaja+mais123.
E2E_USER_A_EMAIL=teste.a@viajamais.local
E2E_USER_A_PASSWORD=
E2E_USER_B_EMAIL=teste.b@viajamais.local
E2E_USER_B_PASSWORD=
